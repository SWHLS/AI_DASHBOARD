const escapeHtml=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function parseCSV(text){let rows=[],row=[],cell='',quoted=false;for(let i=0;i<text.length;i++){let c=text[i];if(c==='"'){if(quoted&&text[i+1]==='"'){cell+='"';i++}else quoted=!quoted}else if(c===','&&!quoted){row.push(cell);cell=''}else if((c==='\n'||c==='\r')&&!quoted){if(c==='\r'&&text[i+1]==='\n')i++;row.push(cell);if(row.some(x=>x.trim()))rows.push(row);row=[];cell=''}else cell+=c}if(quoted)throw Error('CSV 따옴표 형식 오류');if(cell||row.length){row.push(cell);rows.push(row)}const headers=(rows.shift()||[]).map(x=>x.replace(/^\uFEFF/,'').trim());for(const k of ['timestamp','equip_id','status',...metrics.map(m=>m[0])])if(!headers.includes(k))throw Error('필수 열 누락: '+k);return rows.map(r=>Object.fromEntries(headers.map((h,i)=>[h,r[i]??'']))).filter(r=>r.timestamp&&r.equip_id)}
function stamp(t){const m=String(t).match(/^(\d{4})-(\d{1,2})-(\d{1,2})[ T](\d{1,2}):(\d{2})(?::(\d{2}))?/);return m?Date.UTC(+m[1],+m[2]-1,+m[3],+m[4],+m[5],+(m[6]||0)):0}
function populate(){const selected=$('equipment').value;const ids=[...new Set(data.map(r=>r.equip_id))].sort();$('equipment').replaceChildren(...ids.map(id=>new Option(id,id)));if(ids.includes(selected))$('equipment').value=selected;render()}
function selectedRows(){let rows=data.filter(r=>r.equip_id===$('equipment').value).sort((a,b)=>stamp(a.timestamp)-stamp(b.timestamp));const n=+$('window').value;return n?rows.slice(-n):rows}
function lineSVG(rows,key,width=800,height=260,axes=true){const points=rows.map((r,i)=>({i,v:r[key]===''?NaN:Number(r[key])})).filter(p=>Number.isFinite(p.v));if(!points.length)return '<text x="30" y="80" fill="#92a3bc">측정값 없음</text>';let min=Math.min(...points.map(p=>p.v)),max=Math.max(...points.map(p=>p.v));const pad=axes?48:3,range=max-min||Math.abs(max)*.1||1;min-=range*.12;max+=range*.12;const x=i=>pad+i/Math.max(1,rows.length-1)*(width-pad*1.4),y=v=>height-pad-(v-min)/(max-min)*(height-pad*1.6);let out='';if(axes)for(let i=0;i<4;i++){let val=min+(max-min)*i/3;out+=`<line x1="${pad}" x2="${width-20}" y1="${y(val)}" y2="${y(val)}" stroke="#28364a"/><text x="0" y="${y(val)+4}" fill="#92a3bc" font-size="10">${fmt(val,2)}</text>`}out+=`<polyline fill="none" stroke="#5de1bf" stroke-width="${axes?2.5:2}" stroke-linejoin="round" points="${points.map(p=>`${x(p.i)},${y(p.v)}`).join(' ')}"/>`;if(axes){const p=points.at(-1);out+=`<circle cx="${x(p.i)}" cy="${y(p.v)}" r="4" fill="#5de1bf"/><text x="${pad}" y="${height-4}" fill="#92a3bc" font-size="10">${escapeHtml(rows[0].timestamp)}</text><text x="${width-20}" y="${height-4}" text-anchor="end" fill="#92a3bc" font-size="10">${escapeHtml(rows.at(-1).timestamp)}</text>`}return out}
function render(){const rows=selectedRows(),last=rows.at(-1)||{};$('cards').innerHTML=metrics.map(([k,label,n])=>{let nums=rows.map(r=>r[k]===''?NaN:Number(r[k])).filter(Number.isFinite);return `<article class="card"><small>${label} <span style="float:right;color:#5de1bf">↗</span></small><div class="value">${fmt(last[k],n)}</div><div class="range">최저 ${nums.length?fmt(Math.min(...nums),n):'—'} · 최고 ${nums.length?fmt(Math.max(...nums),n):'—'}</div><svg class="spark" viewBox="0 0 220 40" role="img" aria-label="${label} 추이">${lineSVG(rows,k,220,40,false)}</svg></article>`}).join('');$('trend').innerHTML=lineSVG(rows,$('metric').value);$('chartRange').textContent=`${rows.length.toLocaleString()}개 측정 기록`;const run=rows.filter(r=>r.status==='RUN').length,stop=rows.filter(r=>r.status==='STOP').length,pct=rows.length?run/rows.length*100:0;$('ratio').textContent=rows.length?pct.toFixed(1)+'%':'—';$('ring').setAttribute('stroke-dasharray',`${pct/100*452.39} 452.39`);$('runCount').textContent=run;$('stopCount').textContent=stop;$('total').textContent=rows.length;$('recordInfo').textContent='최근 10개 · 최신순';$('records').innerHTML=rows.slice(-10).reverse().map(r=>`<tr><td>${escapeHtml(r.timestamp)}</td><td>${escapeHtml(r.equip_id)}</td>${metrics.map(([k,l,n])=>`<td>${fmt(r[k],n)}</td>`).join('')}<td><span class="status ${r.status==='RUN'?'run':'stop'}">${escapeHtml(['RUN','STOP'].includes(r.status)?r.status:'기타')}</span></td></tr>`).join('');$('stamp').textContent=`최신 측정: ${last.timestamp||'—'} · 데이터 ${data.length}개 · ${lastSuccess?'마지막 동기화: '+lastSuccess:'제작 시 확보한 데이터 표시'}`}
async function refresh(){if(busy)return;busy=true;$('refresh').disabled=true;$('connection').textContent='동기화 중';const controller=new AbortController(),timeout=setTimeout(()=>controller.abort(),15000);try{const response=await fetch(URL_SOURCE+'&_='+Date.now(),{cache:'no-store',signal:controller.signal});if(!response.ok)throw Error('HTTP '+response.status);const next=parseCSV(await response.text());if(!next.length)throw Error('유효한 기록이 없습니다');data=next;lastSuccess=new Date().toLocaleString('ko-KR',{timeZone:'Asia/Seoul'})+' KST';populate();$('connection').textContent='● 연결됨';$('notice').textContent=''}catch(e){$('connection').textContent='저장 데이터 표시';$('notice').textContent='갱신 실패: 기존 데이터를 유지합니다. 네트워크 또는 Google Sheets 공개 설정을 확인해 주세요. CSV 파일을 직접 불러올 수도 있습니다.'}finally{clearTimeout(timeout);busy=false;$('refresh').disabled=false}}
$('metric').replaceChildren(...metrics.map(([k,label])=>new Option(label,k)));$('source').href=URL_SOURCE;$('equipment').onchange=render;$('window').onchange=render;$('metric').onchange=render;$('refresh').onclick=refresh;
const importLabel=document.createElement('label');importLabel.style.cssText='font-size:11px;margin-left:12px;cursor:pointer;color:#5de1bf';importLabel.textContent='CSV 불러오기';const input=document.createElement('input');input.type='file';input.accept='.csv,text/csv';input.style.display='none';input.onchange=async()=>{try{const next=parseCSV(await input.files[0].text());if(!next.length)throw Error('빈 데이터');data=next;lastSuccess=null;$('auto').checked=false;populate();$('connection').textContent='수동 CSV';$('notice').textContent='업로드한 CSV 표시 중 · 자동 갱신이 해제되었습니다.'}catch(e){$('notice').textContent='CSV를 읽을 수 없습니다: '+e.message}};importLabel.append(input);$('refresh').parentNode.append(importLabel);
populate();refresh();setInterval(()=>{if($('auto').checked&&!document.hidden)refresh()},30000);
</script></body></html>
